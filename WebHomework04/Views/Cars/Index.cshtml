@using WebHomework04.Models
@model List<Car>

<h2 class ="fw-bold">Available Cars</h2>
<p class="fw-bold">Select a car below to book it.</p>
@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No cars are currently available.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (Car car in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@car.Name</h5>

                        <p class="card-text">
                            PKR @car.PricePerDay / day
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>

                        <form asp-controller="Cars"
                              asp-action="BookCar"
                              method="post"
                              class="mt-auto">

                            <input type="hidden"
                                   name="id"
                                   value="@car.Id" />

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Book Car
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
